# Replace this with your Render backend URL once deployed
# e.g. https://xamify-backend.onrender.com
VITE_API_URL=http://localhost:8000

# Supabase — from your project's API settings. The publishable key is safe
# to ship in the frontend bundle; never put the service_role / secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
